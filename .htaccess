# ============================================================
# D'LICIAS GOURMET — CONFIGURAÇÃO DO SERVIDOR
# ------------------------------------------------------------
# O site está hospedado na Hostinger, que usa Apache — é aqui
# que ficam o cache, a compressão e a segurança.
#
# IMPORTANTE: este arquivo precisa ir junto para o servidor.
# Ele começa com ponto, então alguns programas de FTP o escondem:
# procure a opção "mostrar arquivos ocultos" antes de enviar.
#
# Em Netlify, Vercel ou GitHub Pages ele seria ignorado.
# ============================================================

# ------------------------------------------------------------
# TIPOS DE ARQUIVO
# Servidores mais antigos não conhecem o WebP e acabam entregando
# a foto como "arquivo genérico" — aí o navegador não a exibe.
# ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  # As fontes já vêm compactadas de fábrica; só precisam do tipo certo
  AddType font/woff2 .woff2
</IfModule>

# ------------------------------------------------------------
# COMPRESSÃO
# Textos viajam compactados: o site chega bem mais rápido.
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------
# CACHE DO NAVEGADOR
# ------------------------------------------------------------
# A regra depende de o arquivo poder mudar sem mudar de nome:
#
#   Fotos e fontes  → guardar por 1 ano. Trocar uma foto na prática
#                     significa subir um arquivo novo, então não há
#                     risco de alguém ficar preso na versão velha.
#
#   CSS e JS        → guardar, mas CONFERIR a cada visita. Eles têm
#                     nome fixo (estilo.css, main.js): com cache
#                     longo, quem já visitou o site ficaria preso na
#                     versão antiga por um ano, sem receber correção
#                     nenhuma. Com "no-cache" o navegador pergunta se
#                     mudou e, se não mudou, o servidor responde "304"
#                     sem reenviar o arquivo — rápido e sempre certo.
#
#   HTML            → sempre conferido, pelo mesmo motivo.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"

  ExpiresByType text/css                "access plus 0 seconds"
  ExpiresByType application/javascript  "access plus 0 seconds"
  ExpiresByType text/javascript         "access plus 0 seconds"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Fotos e fontes: o nome muda quando o conteúdo muda
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Código e HTML: nome fixo, então tem de ser reconferido sempre
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ----------------------------------------------------------
  # SEGURANÇA
  # ----------------------------------------------------------

  # Só acessar por HTTPS, por 2 anos
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Ninguém pode embutir o site dentro de outro (evita golpe de clique)
  Header always set X-Frame-Options "SAMEORIGIN"

  # O navegador não tenta adivinhar o tipo do arquivo
  Header always set X-Content-Type-Options "nosniff"

  # Limita o endereço enviado a outros sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Isola a janela do site de outras abas
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # De onde o site pode carregar cada coisa. Como as fontes agora ficam
  # aqui mesmo, o único domínio de fora é o do mapa. O 'unsafe-inline'
  # é necessário por causa dos "onerror" das fotos dentro do HTML.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ------------------------------------------------------------
# REDIRECIONA PARA HTTPS
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
