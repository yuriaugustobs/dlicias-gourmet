# ============================================================
# D'LICIAS GOURMET — CONFIGURAÇÃO DO SERVIDOR (Apache)
# ------------------------------------------------------------
# Vale para hospedagens Apache (Hostinger, cPanel e similares).
# Em Netlify, Vercel ou GitHub Pages este arquivo é ignorado —
# lá o cache já vem configurado pela própria plataforma.
# ============================================================

# ------------------------------------------------------------
# COMPRESSÃO
# Textos viajam compactados: o site chega bem mais rápido.
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------
# CACHE DO NAVEGADOR
# Quem já visitou não baixa tudo de novo. As fotos e os arquivos
# de estilo ficam guardados por um ano; o HTML sempre é conferido,
# para que uma atualização do site apareça na hora.
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"

  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"

  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Arquivos que não mudam de nome: cache longo
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # O HTML é sempre reconferido, para as mudanças aparecerem logo
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ----------------------------------------------------------
  # SEGURANÇA
  # ----------------------------------------------------------

  # Só acessar por HTTPS, por 2 anos
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Ninguém pode embutir o site dentro de outro (evita golpe de clique)
  Header always set X-Frame-Options "SAMEORIGIN"

  # O navegador não tenta adivinhar o tipo do arquivo
  Header always set X-Content-Type-Options "nosniff"

  # Limita o endereço enviado a outros sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Isola a janela do site de outras abas
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # De onde o site pode carregar cada coisa. 'unsafe-inline' é
  # necessário porque há estilos e pequenos scripts dentro do HTML.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ------------------------------------------------------------
# REDIRECIONA PARA HTTPS
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
